# Copier ce fichier en .env.local et le remplir. Ne jamais committer .env.local.

# Supabase (Project Settings > API). Projet à créer en région UE.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : côté serveur uniquement, jamais dans le navigateur.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Adresse publique de l'appli (sert aux liens de connexion).
APP_URL=http://localhost:3000

# Secret partagé avec le service de réception des mails (au moins 32 caractères).
# Générer avec : openssl rand -hex 32
INBOUND_SECRET=a-remplacer

# Secret de la tâche de purge quotidienne (Vercel Cron l'envoie automatiquement).
CRON_SECRET=a-remplacer

# Domaines autorisés à envoyer des demandes d'intervention (séparés par des virgules).
DOMAINES_EXPEDITEURS_AUTORISES=aih.test
